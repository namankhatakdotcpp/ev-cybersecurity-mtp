# Vendored engine install and venvs - large, not our source
BeamNG.tech.v0.38.3.0/*
# ...except our own additive Lua extensions, which are project source code
# (un-ignore each intermediate directory level too - git won't descend into
# an ignored directory to apply a deeper negation otherwise)
!BeamNG.tech.v0.38.3.0/lua/
BeamNG.tech.v0.38.3.0/lua/*
!BeamNG.tech.v0.38.3.0/lua/ge/
BeamNG.tech.v0.38.3.0/lua/ge/*
!BeamNG.tech.v0.38.3.0/lua/ge/extensions/
BeamNG.tech.v0.38.3.0/lua/ge/extensions/*
!BeamNG.tech.v0.38.3.0/lua/ge/extensions/evHeadPoseLogger.lua
backend/vEVTrip/

# Raw/derived data - large, participant data, not source code
backend/raw_data/
backend/Muse/decoded/
backend/rag_index/
backend/rag_index_archive/

# Large media
*.mp4
*.mov

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS cruft
.DS_Store

# Secrets - never commit (API keys live here, e.g. GEMINI_API_KEY)
.env
*.env
backend/.env

# Other large/non-source blobs seen untracked - not project source
backend/Muse/*.zip
backend/audio/
backend/images/
backend/screenshots/
backend/screenshots_analysis.csv
backend/interaction_logs/
backend/intake_web/
gaze_pilot_out/
backend/rag_contaminated_sessions.json

# Raw Varjo gaze CSVs + screen-capture mp4s (participant data / 1.5TB) and macOS AppleDouble files
Varjo/
._*

# Gate 2 outputs: row-level artifacts and analysis tables stay local; registry.csv and per-run summary.json are tracked
results/_tables/
results/**/artifacts/
